{
  "scope": "aux4",
  "name": "bot",
  "version": "0.2.3",
  "description": "Generic multi-channel chatbot core: webhook -> claim-dedupe -> durable work queue -> lease/ack/nack -> plugin send",
  "dependencies": [
    "aux4/queue@>=0.2.3",
    "aux4/api@>=2.1.12",
    "aux4/repository@>=1.3.4"
  ],
  "system": [
    [
      "test:node --version",
      "brew:node"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "bot",
          "execute": [
            "profile:bot"
          ],
          "help": {
            "text": "Generic multi-channel chatbot core"
          }
        }
      ]
    },
    {
      "name": "bot",
      "commands": [
        {
          "name": "verify",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs verify values(channels, bots, defaults)"
          ],
          "help": {
            "text": "aux4/api route handler for GET /{channel}/{bot}/webhook (platform verification handshake)",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              }
            ]
          }
        },
        {
          "name": "ingest",
          "private": true,
          "noHooks": true,
          "execute": [
            "json:stdin:node ${packageDir}/lib/bot.mjs ingest-prepare values(channels, bots, defaults, db, dedupeTtl)",
            "set:toSend=${response.toSend}",
            "set:replyStatus=${response.statusCode}",
            "set:replyBody=${response.body}",
            "node ${packageDir}/lib/bot.mjs ingest-send values(queue, db, toSend, replyStatus, replyBody)"
          ],
          "help": {
            "text": "aux4/api route handler for POST /{channel}/{bot}/webhook (verify -> claim dedupe -> 'aux4 queue send --provider <queue.provider> --group <chatId>' -> ack)",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state: event dedupe + conversations (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "dedupeTtl",
                "text": "Event dedupe window in seconds, when a plugin event has no ttl of its own",
                "default": "300"
              },
              {
                "name": "queue",
                "text": "aux4/queue config: {name, provider, db, visibility, maxAttempts, port, token} (provider accepts memory|repository|sqs|cloud|... ; the old command/storage keys still work as aliases for one version)",
                "default": "{\"provider\":\"memory\",\"name\":\"bot-inbox\",\"db\":\".bot/queue.db\",\"visibility\":\"30\",\"maxAttempts\":\"5\",\"port\":\"8420\",\"token\":\"\"}"
              },
              {
                "name": "toSend",
                "text": "Internal: set by this command's own pipeline (the events to enqueue) \u2014 not meant to be passed in",
                "default": "[]"
              },
              {
                "name": "replyStatus",
                "text": "Internal: the HTTP status to reply with on success",
                "default": "200"
              },
              {
                "name": "replyBody",
                "text": "Internal: the HTTP body to reply with on success",
                "default": "{}"
              }
            ]
          }
        },
        {
          "name": "work",
          "execute": [
            "stdin:aux4 bot value(mode) param(channels) param(bots) param(defaults) param(db) param(tmpDir) param(queue)"
          ],
          "help": {
            "text": "Process exactly one message: dispatches via a validated dynamic subcommand (aux4 bot value(mode) ...) to 'pull' (default; self-leases the next eligible message from the queue and acks/nacks it) or 'push' (the aux4/api route handler for POST /bot/work, processing the message given in the request body directly, no lease). Suitable for a single Lambda-style invocation",
            "variables": [
              {
                "name": "mode",
                "text": "pull (self-lease from the queue) or push (process the request body directly, no lease)",
                "default": "pull",
                "options": [
                  "pull",
                  "push"
                ]
              },
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state: event dedupe + conversations (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "tmpDir",
                "text": "Working directory for downloaded attachments",
                "default": ".bot/tmp"
              },
              {
                "name": "queue",
                "text": "aux4/queue config: {name, provider, db, visibility, maxAttempts, port, token} (provider accepts memory|repository|sqs|cloud|... ; the old command/storage keys still work as aliases for one version)",
                "default": "{\"provider\":\"memory\",\"name\":\"bot-inbox\",\"db\":\".bot/queue.db\",\"visibility\":\"30\",\"maxAttempts\":\"5\",\"port\":\"8420\",\"token\":\"\"}"
              }
            ]
          }
        },
        {
          "name": "pull",
          "private": true,
          "noHooks": true,
          "execute": [
            "nout:aux4 queue lease --provider nvl(queue.provider, queue.storage, 'memory') param(queue.name:name) param(queue.db:db) param(queue.port:port) param(queue.token:token) param(queue.visibility:visibility) param(queue.maxAttempts:maxAttempts); true",
            "json:node ${packageDir}/lib/bot.mjs lease-normalize values(response)",
            "node ${packageDir}/lib/bot.mjs work-pull-process values(channels, bots, defaults, db, tmpDir, queue, response)"
          ],
          "help": {
            "text": "Self-lease the next eligible message from the queue (one at a time per group) via the validated provider dispatch (see 'provider'), process it (renewing the lease while the brain runs), and ack on success or nack on a brain failure. The lease call is allowed to find nothing eligible (exits non-zero; the trailing ';true' is a plain unconditional sequence, not a conditional branch, so the pipeline can inspect the normalized {leased:false} result instead of the exit code) \u2014 everything past that point (the empty check, the ack/nack decision, the failureMessage reply) is decided in lib/worker.js, not here, since aux4's own templating cannot safely branch on a value that may be empty (see README)",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "tmpDir",
                "text": "Working directory for downloaded attachments",
                "default": ".bot/tmp"
              },
              {
                "name": "queue",
                "text": "aux4/queue config: {name, provider, db, visibility, maxAttempts, port, token} (provider accepts memory|repository|sqs|cloud|... ; the old command/storage keys still work as aliases for one version)",
                "default": "{\"provider\":\"memory\",\"name\":\"bot-inbox\",\"db\":\".bot/queue.db\",\"visibility\":\"30\",\"maxAttempts\":\"5\",\"port\":\"8420\",\"token\":\"\"}"
              },
              {
                "name": "response",
                "text": "Internal: set by this command's own pipeline (the normalized lease) \u2014 not meant to be passed in",
                "default": "{}"
              }
            ]
          }
        },
        {
          "name": "push",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs work-push values(channels, bots, defaults, db, tmpDir)"
          ],
          "help": {
            "text": "aux4/api route handler for POST /bot/work: processes the {channel,botId,event} message in the request body directly, no lease/ack/nack. Used for push-style delivery \u2014 a work queue's own retry-safe --webhook push (aux4/queue >=0.2.3), or any other system that can POST JSON",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "tmpDir",
                "text": "Working directory for downloaded attachments",
                "default": ".bot/tmp"
              }
            ]
          }
        },
        {
          "name": "worker",
          "execute": [
            "while true; do aux4 bot work --mode pull param(channels) param(bots) param(defaults) param(db) param(tmpDir) param(queue); sleep value(pollInterval); done"
          ],
          "help": {
            "text": "Long-running loop around 'aux4 bot work --mode pull': lease -> process -> ack/nack, repeated forever with a fixed poll interval when idle",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "tmpDir",
                "text": "Working directory for downloaded attachments",
                "default": ".bot/tmp"
              },
              {
                "name": "pollInterval",
                "text": "Seconds to sleep between lease attempts (every attempt, hit or idle)",
                "default": "1"
              },
              {
                "name": "queue",
                "text": "aux4/queue config: {name, provider, db, visibility, maxAttempts, port, token} (provider accepts memory|repository|sqs|cloud|... ; the old command/storage keys still work as aliases for one version)",
                "default": "{\"provider\":\"memory\",\"name\":\"bot-inbox\",\"db\":\".bot/queue.db\",\"visibility\":\"30\",\"maxAttempts\":\"5\",\"port\":\"8420\",\"token\":\"\"}"
              }
            ]
          }
        },
        {
          "name": "clean",
          "execute": [
            "node ${packageDir}/lib/bot.mjs clean values(db)"
          ],
          "help": {
            "text": "Sweep expired records (ttl in the past) from every repository table aux4/bot manages",
            "variables": [
              {
                "name": "db",
                "text": "Repository database (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              }
            ]
          }
        },
        {
          "name": "echo",
          "execute": [
            "profile:bot:echo"
          ],
          "help": {
            "text": "The 'echo' channel plugin \u2014 a reference implementation and in-repo test fixture (not a real platform)"
          }
        }
      ]
    },
    {
      "name": "bot:echo",
      "commands": [
        {
          "name": "verify",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-verify"
          ],
          "help": {
            "text": "echo plugin: verify an inbound request (HMAC-SHA256 over the raw body, or echo a GET handshake challenge)"
          }
        },
        {
          "name": "ingest-parse",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-ingest-parse"
          ],
          "help": {
            "text": "echo plugin: parse a raw webhook body into normalized core events"
          }
        },
        {
          "name": "typing",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-typing"
          ],
          "help": {
            "text": "echo plugin: signal that a reply is being worked on"
          }
        },
        {
          "name": "download",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-download"
          ],
          "help": {
            "text": "echo plugin: materialize an attached file onto local disk"
          }
        },
        {
          "name": "format",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-format"
          ],
          "help": {
            "text": "echo plugin: convert the brain's markdown answer into the channel's native format"
          }
        },
        {
          "name": "send",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-send"
          ],
          "help": {
            "text": "echo plugin: deliver the formatted reply"
          }
        }
      ]
    }
  ]
}

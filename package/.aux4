{
  "scope": "aux4",
  "name": "bot",
  "version": "0.2.2",
  "description": "Generic multi-channel chatbot core: webhook -> claim-dedupe -> durable work queue -> lease/ack/nack -> plugin send",
  "dependencies": [
    "aux4/queue@>=0.2.3",
    "aux4/api@>=2.1.12",
    "aux4/repository@>=1.3.4"
  ],
  "system": [
    [
      "test:node --version",
      "brew:node"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "bot",
          "execute": [
            "profile:bot"
          ],
          "help": {
            "text": "Generic multi-channel chatbot core"
          }
        }
      ]
    },
    {
      "name": "bot",
      "commands": [
        {
          "name": "verify",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs verify values(channels, bots, defaults)"
          ],
          "help": {
            "text": "aux4/api route handler for GET /{channel}/{bot}/webhook (platform verification handshake)",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              }
            ]
          }
        },
        {
          "name": "ingest",
          "private": true,
          "noHooks": true,
          "execute": [
            "json:stdin:node ${packageDir}/lib/bot.mjs ingest-prepare values(channels, bots, defaults, db, dedupeTtl)",
            "set:toSend=${response.toSend}",
            "set:replyStatus=${response.statusCode}",
            "set:replyBody=${response.body}",
            "node ${packageDir}/lib/bot.mjs ingest-send values(queue, db, toSend, replyStatus, replyBody)"
          ],
          "help": {
            "text": "aux4/api route handler for POST /{channel}/{bot}/webhook (verify -> claim dedupe -> '<queue.command> send --group <chatId>' -> ack)",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state: event dedupe + conversations (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "dedupeTtl",
                "text": "Event dedupe window in seconds, when a plugin event has no ttl of its own",
                "default": "300"
              },
              {
                "name": "queue",
                "text": "Work-queue config: {command, name, storage, db, visibility, maxAttempts, port, token}. command is a validated provider key dispatched via 'aux4 bot provider <key> ...' (see that command) — 'queue' (default, aux4/queue) or 'queue-sqs' (aux4/queue-sqs, once BOT-017 lands); an unlisted key fails closed (Command not found), never shells out to an arbitrary string. storage is memory|repository (ignored by a provider that has no such concept); db/port/token are only used by the matching storage",
                "default": "{\"command\":\"queue\",\"name\":\"bot-inbox\",\"storage\":\"memory\",\"db\":\".bot/queue.db\",\"visibility\":\"30\",\"maxAttempts\":\"5\",\"port\":\"8420\",\"token\":\"\"}"
              },
              {
                "name": "toSend",
                "text": "Internal: set by this command's own pipeline (the events to enqueue) — not meant to be passed in",
                "default": "[]"
              },
              {
                "name": "replyStatus",
                "text": "Internal: the HTTP status to reply with on success",
                "default": "200"
              },
              {
                "name": "replyBody",
                "text": "Internal: the HTTP body to reply with on success",
                "default": "{}"
              }
            ]
          }
        },
        {
          "name": "work",
          "execute": [
            "stdin:aux4 bot value(mode) param(channels) param(bots) param(defaults) param(db) param(tmpDir) param(queue)"
          ],
          "help": {
            "text": "Process exactly one message: dispatches via a validated dynamic subcommand (aux4 bot value(mode) ...) to 'pull' (default; self-leases the next eligible message from the queue and acks/nacks it) or 'push' (the aux4/api route handler for POST /bot/work, processing the message given in the request body directly, no lease). Suitable for a single Lambda-style invocation",
            "variables": [
              {
                "name": "mode",
                "text": "pull (self-lease from the queue) or push (process the request body directly, no lease)",
                "default": "pull",
                "options": [
                  "pull",
                  "push"
                ]
              },
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state: event dedupe + conversations (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "tmpDir",
                "text": "Working directory for downloaded attachments",
                "default": ".bot/tmp"
              },
              {
                "name": "queue",
                "text": "Work-queue config (--mode pull only): {command, name, storage, db, visibility, maxAttempts, port, token}. command is a validated provider key ('queue' default) dispatched via 'aux4 bot provider' — see 'pull'",
                "default": "{\"command\":\"queue\",\"name\":\"bot-inbox\",\"storage\":\"memory\",\"db\":\".bot/queue.db\",\"visibility\":\"30\",\"maxAttempts\":\"5\",\"port\":\"8420\",\"token\":\"\"}"
              }
            ]
          }
        },
        {
          "name": "pull",
          "private": true,
          "noHooks": true,
          "execute": [
            "nout:aux4 bot provider value(queue.command) lease param(queue.name:name) param(queue.storage:storage) param(queue.db:db) param(queue.port:port) param(queue.token:token) param(queue.visibility:visibility) param(queue.maxAttempts:maxAttempts); true",
            "json:node ${packageDir}/lib/bot.mjs lease-normalize values(response)",
            "node ${packageDir}/lib/bot.mjs work-pull-process values(channels, bots, defaults, db, tmpDir, queue, response)"
          ],
          "help": {
            "text": "Self-lease the next eligible message from the queue (one at a time per group) via the validated provider dispatch (see 'provider'), process it (renewing the lease while the brain runs), and ack on success or nack on a brain failure. The lease call is allowed to find nothing eligible (exits non-zero; the trailing ';true' is a plain unconditional sequence, not a conditional branch, so the pipeline can inspect the normalized {leased:false} result instead of the exit code) — everything past that point (the empty check, the ack/nack decision, the failureMessage reply) is decided in lib/worker.js, not here, since aux4's own templating cannot safely branch on a value that may be empty (see README)",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "tmpDir",
                "text": "Working directory for downloaded attachments",
                "default": ".bot/tmp"
              },
              {
                "name": "queue",
                "text": "aux4/queue config: {name, storage, db, visibility, maxAttempts, port, token}",
                "default": "{\"command\":\"queue\",\"name\":\"bot-inbox\",\"storage\":\"memory\",\"db\":\".bot/queue.db\",\"visibility\":\"30\",\"maxAttempts\":\"5\",\"port\":\"8420\",\"token\":\"\"}"
              },
              {
                "name": "response",
                "text": "Internal: set by this command's own pipeline (the normalized lease) — not meant to be passed in",
                "default": "{}"
              }
            ]
          }
        },
        {
          "name": "push",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs work-push values(channels, bots, defaults, db, tmpDir)"
          ],
          "help": {
            "text": "aux4/api route handler for POST /bot/work: processes the {channel,botId,event} message in the request body directly, no lease/ack/nack. Used for push-style delivery — a work queue's own retry-safe --webhook push (aux4/queue >=0.2.3), or any other system that can POST JSON",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "tmpDir",
                "text": "Working directory for downloaded attachments",
                "default": ".bot/tmp"
              }
            ]
          }
        },
        {
          "name": "worker",
          "execute": [
            "while true; do aux4 bot work --mode pull param(channels) param(bots) param(defaults) param(db) param(tmpDir) param(queue); sleep value(pollInterval); done"
          ],
          "help": {
            "text": "Long-running loop around 'aux4 bot work --mode pull': lease -> process -> ack/nack, repeated forever with a fixed poll interval when idle",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "tmpDir",
                "text": "Working directory for downloaded attachments",
                "default": ".bot/tmp"
              },
              {
                "name": "pollInterval",
                "text": "Seconds to sleep between lease attempts (every attempt, hit or idle)",
                "default": "1"
              },
              {
                "name": "queue",
                "text": "aux4/queue config: {name, storage, db, visibility, maxAttempts, port, token}",
                "default": "{\"command\":\"queue\",\"name\":\"bot-inbox\",\"storage\":\"memory\",\"db\":\".bot/queue.db\",\"visibility\":\"30\",\"maxAttempts\":\"5\",\"port\":\"8420\",\"token\":\"\"}"
              }
            ]
          }
        },
        {
          "name": "clean",
          "execute": [
            "node ${packageDir}/lib/bot.mjs clean values(db)"
          ],
          "help": {
            "text": "Sweep expired records (ttl in the past) from every repository table aux4/bot manages",
            "variables": [
              {
                "name": "db",
                "text": "Repository database (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              }
            ]
          }
        },
        {
          "name": "echo",
          "execute": [
            "profile:bot:echo"
          ],
          "help": {
            "text": "The 'echo' channel plugin — a reference implementation and in-repo test fixture (not a real platform)"
          }
        },
        {
          "name": "provider",
          "private": true,
          "execute": [
            "profile:bot:provider"
          ],
          "help": {
            "text": "Validated dynamic-subcommand dispatch to the configured queue backend (queue.command: 'queue' or 'queue-sqs') -- the ONE place that allowlist lives; an unlisted key fails closed (Command not found) instead of shelling out to an arbitrary string. Internal, called by 'ingest'/'pull' and from lib/provider.js, never directly"
          }
        }
      ]
    },
    {
      "name": "bot:provider",
      "commands": [
        {
          "name": "queue",
          "private": true,
          "execute": [
            "profile:bot:provider:queue"
          ],
          "help": {
            "text": "queue backend dispatch target: aux4/queue (internal)"
          }
        },
        {
          "name": "queue-sqs",
          "private": true,
          "execute": [
            "profile:bot:provider:queue-sqs"
          ],
          "help": {
            "text": "queue backend dispatch target: aux4/queue-sqs, once BOT-017 lands (internal, not yet implemented)"
          }
        }
      ]
    },
    {
      "name": "bot:provider:queue",
      "commands": [
        {
          "name": "send",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:aux4 queue send param(name) param(storage) param(db) param(port) param(token) param(group)"
          ],
          "help": {
            "text": "aux4/queue: send a message (body piped via stdin)",
            "variables": [
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "storage",
                "text": "Storage backend",
                "default": "memory"
              },
              {
                "name": "db",
                "text": "Database path or libsql:// URL",
                "default": ""
              },
              {
                "name": "port",
                "text": "Server port",
                "default": ""
              },
              {
                "name": "token",
                "text": "Authentication token",
                "default": ""
              },
              {
                "name": "group",
                "text": "Group key for one-at-a-time delivery",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "lease",
          "private": true,
          "noHooks": true,
          "execute": [
            "aux4 queue lease param(name) param(storage) param(db) param(port) param(token) param(visibility) param(maxAttempts)"
          ],
          "help": {
            "text": "aux4/queue: lease the next eligible message",
            "variables": [
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "storage",
                "text": "Storage backend",
                "default": "memory"
              },
              {
                "name": "db",
                "text": "Database path or libsql:// URL",
                "default": ""
              },
              {
                "name": "port",
                "text": "Server port",
                "default": ""
              },
              {
                "name": "token",
                "text": "Authentication token",
                "default": ""
              },
              {
                "name": "visibility",
                "text": "Visibility timeout in seconds",
                "default": "30"
              },
              {
                "name": "maxAttempts",
                "text": "The queue's maxAttempts",
                "default": "0"
              }
            ]
          }
        },
        {
          "name": "renew",
          "private": true,
          "noHooks": true,
          "execute": [
            "aux4 queue renew param(name) param(storage) param(db) param(port) param(token) param(leaseId) param(id) param(visibility)"
          ],
          "help": {
            "text": "aux4/queue: extend a still-live lease (heartbeat)",
            "variables": [
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "storage",
                "text": "Storage backend",
                "default": "memory"
              },
              {
                "name": "db",
                "text": "Database path or libsql:// URL",
                "default": ""
              },
              {
                "name": "port",
                "text": "Server port",
                "default": ""
              },
              {
                "name": "token",
                "text": "Authentication token",
                "default": ""
              },
              {
                "name": "leaseId",
                "text": "The leaseId returned by 'lease' (memory storage only)",
                "default": ""
              },
              {
                "name": "id",
                "text": "The message id returned by 'lease' (repository storage only)",
                "default": ""
              },
              {
                "name": "visibility",
                "text": "New visibility timeout in seconds, counted from now",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "ack",
          "private": true,
          "noHooks": true,
          "execute": [
            "aux4 queue ack param(name) param(storage) param(db) param(port) param(token) param(leaseId) param(id)"
          ],
          "help": {
            "text": "aux4/queue: acknowledge (complete) a leased message",
            "variables": [
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "storage",
                "text": "Storage backend",
                "default": "memory"
              },
              {
                "name": "db",
                "text": "Database path or libsql:// URL",
                "default": ""
              },
              {
                "name": "port",
                "text": "Server port",
                "default": ""
              },
              {
                "name": "token",
                "text": "Authentication token",
                "default": ""
              },
              {
                "name": "leaseId",
                "text": "The leaseId returned by 'lease' (memory storage only)",
                "default": ""
              },
              {
                "name": "id",
                "text": "The message id returned by 'lease' (repository storage only)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "nack",
          "private": true,
          "noHooks": true,
          "execute": [
            "aux4 queue nack param(name) param(storage) param(db) param(port) param(token) param(leaseId) param(id) param(maxAttempts)"
          ],
          "help": {
            "text": "aux4/queue: release a leased message for immediate redelivery",
            "variables": [
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "storage",
                "text": "Storage backend",
                "default": "memory"
              },
              {
                "name": "db",
                "text": "Database path or libsql:// URL",
                "default": ""
              },
              {
                "name": "port",
                "text": "Server port",
                "default": ""
              },
              {
                "name": "token",
                "text": "Authentication token",
                "default": ""
              },
              {
                "name": "leaseId",
                "text": "The leaseId returned by 'lease' (memory storage only)",
                "default": ""
              },
              {
                "name": "id",
                "text": "The message id returned by 'lease' (repository storage only)",
                "default": ""
              },
              {
                "name": "maxAttempts",
                "text": "The queue's maxAttempts",
                "default": "0"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "bot:provider:queue-sqs",
      "commands": [
        {
          "name": "send",
          "private": true,
          "noHooks": true,
          "execute": [
            "echo 'Error: aux4/queue-sqs is not implemented yet (BOT-017) -- see package/.aux4 bot:provider:queue-sqs' >&2; exit 1"
          ],
          "help": {
            "text": "placeholder -- not implemented yet (BOT-017)"
          }
        },
        {
          "name": "lease",
          "private": true,
          "noHooks": true,
          "execute": [
            "echo 'Error: aux4/queue-sqs is not implemented yet (BOT-017) -- see package/.aux4 bot:provider:queue-sqs' >&2; exit 1"
          ],
          "help": {
            "text": "placeholder -- not implemented yet (BOT-017)"
          }
        },
        {
          "name": "renew",
          "private": true,
          "noHooks": true,
          "execute": [
            "echo 'Error: aux4/queue-sqs is not implemented yet (BOT-017) -- see package/.aux4 bot:provider:queue-sqs' >&2; exit 1"
          ],
          "help": {
            "text": "placeholder -- not implemented yet (BOT-017)"
          }
        },
        {
          "name": "ack",
          "private": true,
          "noHooks": true,
          "execute": [
            "echo 'Error: aux4/queue-sqs is not implemented yet (BOT-017) -- see package/.aux4 bot:provider:queue-sqs' >&2; exit 1"
          ],
          "help": {
            "text": "placeholder -- not implemented yet (BOT-017)"
          }
        },
        {
          "name": "nack",
          "private": true,
          "noHooks": true,
          "execute": [
            "echo 'Error: aux4/queue-sqs is not implemented yet (BOT-017) -- see package/.aux4 bot:provider:queue-sqs' >&2; exit 1"
          ],
          "help": {
            "text": "placeholder -- not implemented yet (BOT-017)"
          }
        }
      ]
    },
    {
      "name": "bot:echo",
      "commands": [
        {
          "name": "verify",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-verify"
          ],
          "help": {
            "text": "echo plugin: verify an inbound request (HMAC-SHA256 over the raw body, or echo a GET handshake challenge)"
          }
        },
        {
          "name": "ingest-parse",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-ingest-parse"
          ],
          "help": {
            "text": "echo plugin: parse a raw webhook body into normalized core events"
          }
        },
        {
          "name": "typing",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-typing"
          ],
          "help": {
            "text": "echo plugin: signal that a reply is being worked on"
          }
        },
        {
          "name": "download",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-download"
          ],
          "help": {
            "text": "echo plugin: materialize an attached file onto local disk"
          }
        },
        {
          "name": "format",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-format"
          ],
          "help": {
            "text": "echo plugin: convert the brain's markdown answer into the channel's native format"
          }
        },
        {
          "name": "send",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-send"
          ],
          "help": {
            "text": "echo plugin: deliver the formatted reply"
          }
        }
      ]
    }
  ]
}

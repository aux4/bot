{
  "scope": "aux4",
  "name": "bot",
  "version": "0.2.12",
  "description": "Generic multi-channel chatbot core: webhook -> claim-dedupe -> durable work queue -> lease/ack/nack -> plugin send",
  "dependencies": [
    "aux4/queue@>=0.2.3",
    "aux4/api@>=2.1.12",
    "aux4/repository@>=1.3.4"
  ],
  "system": [
    [
      "test:node --version",
      "brew:node"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "bot",
          "execute": [
            "profile:bot"
          ],
          "help": {
            "text": "Generic multi-channel chatbot core"
          }
        }
      ]
    },
    {
      "name": "bot",
      "commands": [
        {
          "name": "verify",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs verify values(channels, bots, defaults)"
          ],
          "help": {
            "text": "aux4/api route handler for GET /{channel}/{bot}/webhook (platform verification handshake)",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              }
            ]
          }
        },
        {
          "name": "ingest",
          "private": true,
          "noHooks": true,
          "execute": [
            "json:stdin:node ${packageDir}/lib/bot.mjs ingest-prepare values(channels, bots, defaults, db, dedupeTtl)",
            "set:toSend=${response.toSend}",
            "set:replyStatus=${response.statusCode}",
            "set:replyBody=${response.body}",
            "node ${packageDir}/lib/bot.mjs ingest-send values(queue, db, toSend, replyStatus, replyBody)"
          ],
          "help": {
            "text": "aux4/api route handler for POST /{channel}/{bot}/webhook (verify -> claim dedupe -> 'aux4 queue send --provider <queue.provider> --group <chatId>' -> ack)",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state: event dedupe + conversations (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "dedupeTtl",
                "text": "Event dedupe window in seconds, when a plugin event has no ttl of its own",
                "default": "300"
              },
              {
                "name": "queue",
                "text": "aux4/queue config: {name, provider, db, visibility, maxAttempts, port, token} (provider accepts memory|repository|sqs|cloud|... ; the old command/storage keys still work as aliases for one version)",
                "default": "{\"provider\":\"memory\",\"name\":\"bot-inbox\",\"db\":\".bot/queue.db\",\"visibility\":\"30\",\"maxAttempts\":\"5\",\"port\":\"8420\",\"token\":\"\"}"
              },
              {
                "name": "toSend",
                "text": "Internal: set by this command's own pipeline (the events to enqueue) — not meant to be passed in",
                "default": "[]"
              },
              {
                "name": "replyStatus",
                "text": "Internal: the HTTP status to reply with on success",
                "default": "200"
              },
              {
                "name": "replyBody",
                "text": "Internal: the HTTP body to reply with on success",
                "default": "{}"
              }
            ]
          }
        },
        {
          "name": "work",
          "execute": [
            "stdin:aux4 bot value(mode) param(channels) param(bots) param(defaults) param(db) param(tmpDir) param(queue)"
          ],
          "help": {
            "text": "Process exactly one message: dispatches via a validated dynamic subcommand (aux4 bot value(mode) ...) to 'pull' (default; self-leases the next eligible message from the queue and acks/nacks it) or 'push' (the aux4/api route handler for POST /bot/work, processing the message given in the request body directly, no lease). Suitable for a single Lambda-style invocation",
            "variables": [
              {
                "name": "mode",
                "text": "pull (self-lease from the queue) or push (process the request body directly, no lease)",
                "default": "pull",
                "options": [
                  "pull",
                  "push"
                ]
              },
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state: event dedupe + conversations (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "tmpDir",
                "text": "Working directory for downloaded attachments",
                "default": ".bot/tmp"
              },
              {
                "name": "queue",
                "text": "aux4/queue config: {name, provider, db, visibility, maxAttempts, port, token} (provider accepts memory|repository|sqs|cloud|... ; the old command/storage keys still work as aliases for one version)",
                "default": "{\"provider\":\"memory\",\"name\":\"bot-inbox\",\"db\":\".bot/queue.db\",\"visibility\":\"30\",\"maxAttempts\":\"5\",\"port\":\"8420\",\"token\":\"\"}"
              }
            ]
          }
        },
        {
          "name": "retry-work",
          "noHooks": true,
          "execute": [
            "node ${packageDir}/lib/bot.mjs work-retry values(channels, bots, defaults, db, tmpDir, queue, expected, attempts, delay, maxDelay, budget, maxMessages)"
          ],
          "help": {
            "text": "Drain queued work with bounded retries, exponential backoff and existing lease/dedupe protection",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "tmpDir",
                "text": "Working directory for downloaded attachments",
                "default": ".bot/tmp"
              },
              {
                "name": "queue",
                "text": "aux4/queue config: {name, provider, db, visibility, maxAttempts, port, token} (provider accepts memory|repository|sqs|cloud|... ; the old command/storage keys still work as aliases for one version)",
                "default": "{\"provider\":\"memory\",\"name\":\"bot-inbox\",\"db\":\".bot/queue.db\",\"visibility\":\"30\",\"maxAttempts\":\"5\",\"port\":\"8420\",\"token\":\"\"}"
              },
              {
                "name": "expected",
                "text": "New messages enqueued by this delivery; retry an empty lease until these are processed",
                "default": "0"
              },
              {
                "name": "attempts",
                "text": "Maximum consecutive failed or unexpectedly empty attempts (1-10)",
                "default": "6"
              },
              {
                "name": "delay",
                "text": "Initial retry delay in milliseconds",
                "default": "1000"
              },
              {
                "name": "maxDelay",
                "text": "Maximum retry delay in milliseconds",
                "default": "15000"
              },
              {
                "name": "budget",
                "text": "Time budget in milliseconds for starting attempts; an in-flight attempt retains its configured timeout",
                "default": "240000"
              },
              {
                "name": "maxMessages",
                "text": "Maximum messages to acknowledge in this invocation",
                "default": "100"
              }
            ]
          }
        },
        {
          "name": "pull",
          "private": true,
          "noHooks": true,
          "execute": [
            "node ${packageDir}/lib/bot.mjs work-pull values(channels, bots, defaults, db, tmpDir, queue)"
          ],
          "help": {
            "text": "Lease and process one message through the queue provider. Only its documented empty result becomes leased:false; provider, authentication, database and malformed-response failures remain errors. The worker renews live leases and acknowledges or nacks processing as before.",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "tmpDir",
                "text": "Working directory for downloaded attachments",
                "default": ".bot/tmp"
              },
              {
                "name": "queue",
                "text": "aux4/queue config: {name, provider, db, visibility, maxAttempts, port, token} (provider accepts memory|repository|sqs|cloud|... ; the old command/storage keys still work as aliases for one version)",
                "default": "{\"provider\":\"memory\",\"name\":\"bot-inbox\",\"db\":\".bot/queue.db\",\"visibility\":\"30\",\"maxAttempts\":\"5\",\"port\":\"8420\",\"token\":\"\"}"
              }
            ]
          }
        },
        {
          "name": "push",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs work-push values(channels, bots, defaults, db, tmpDir)"
          ],
          "help": {
            "text": "aux4/api route handler for POST /bot/work: processes the {channel,botId,event} message in the request body directly, no lease/ack/nack. Used for push-style delivery — a work queue's own retry-safe --webhook push (aux4/queue >=0.2.3), or any other system that can POST JSON",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "tmpDir",
                "text": "Working directory for downloaded attachments",
                "default": ".bot/tmp"
              }
            ]
          }
        },
        {
          "name": "worker",
          "execute": [
            "while true; do aux4 bot work --mode pull param(channels) param(bots) param(defaults) param(db) param(tmpDir) param(queue); sleep value(pollInterval); done"
          ],
          "help": {
            "text": "Long-running loop around 'aux4 bot work --mode pull': lease -> process -> ack/nack, repeated forever with a fixed poll interval when idle",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              },
              {
                "name": "tmpDir",
                "text": "Working directory for downloaded attachments",
                "default": ".bot/tmp"
              },
              {
                "name": "pollInterval",
                "text": "Seconds to sleep between lease attempts (every attempt, hit or idle)",
                "default": "1"
              },
              {
                "name": "queue",
                "text": "aux4/queue config: {name, provider, db, visibility, maxAttempts, port, token} (provider accepts memory|repository|sqs|cloud|... ; the old command/storage keys still work as aliases for one version)",
                "default": "{\"provider\":\"memory\",\"name\":\"bot-inbox\",\"db\":\".bot/queue.db\",\"visibility\":\"30\",\"maxAttempts\":\"5\",\"port\":\"8420\",\"token\":\"\"}"
              }
            ]
          }
        },
        {
          "name": "clean",
          "execute": [
            "node ${packageDir}/lib/bot.mjs clean values(db)"
          ],
          "help": {
            "text": "Sweep expired records (ttl in the past) from every repository table aux4/bot manages",
            "variables": [
              {
                "name": "db",
                "text": "Repository database (local sqlite path or libsql:// URL)",
                "default": ".bot/state.db"
              }
            ]
          }
        },
        {
          "name": "send",
          "execute": [
            "node ${packageDir}/lib/bot.mjs send values(botId, to, text, bots, defaults, db)"
          ],
          "help": {
            "text": "Send an ad hoc, proactive message to a chat -- NOT tied to an inbound event -- through the bot's own channel plugin (read from bots.<botId>.channel), format then send. Logged as outbound in the message log on success. A plugin may refuse instead of sending (e.g. WhatsApp outside its 24h free-form session window, pointing at 'send-template') -- this command fails loudly (stderr + exit 1) on a refusal or a send error, unlike the worker's own best-effort reply",
            "variables": [
              {
                "name": "botId",
                "text": "Bot id, as configured under bots.<id>",
                "arg": true
              },
              {
                "name": "to",
                "text": "Destination chat id"
              },
              {
                "name": "text",
                "text": "Markdown text to send"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database for bot state (message log)",
                "default": ".bot/state.db"
              }
            ]
          }
        },
        {
          "name": "complete",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs complete values(channels, bots, defaults, db)"
          ],
          "help": {
            "text": "Accept an authenticated agent callback and deliver the reply using the stored request routing",
            "variables": [
              {
                "name": "channels",
                "text": "Allowlisted channel names (JSON array)",
                "default": "[]"
              },
              {
                "name": "bots",
                "text": "Map of botId -> per-bot config (JSON object)",
                "default": "{}"
              },
              {
                "name": "defaults",
                "text": "Shared defaults merged under every bot (JSON object)",
                "default": "{}"
              },
              {
                "name": "db",
                "text": "Repository database containing callback request state",
                "default": ".bot/state.db"
              }
            ]
          }
        },
        {
          "name": "conversations",
          "execute": [
            "node ${packageDir}/lib/bot.mjs conversations values(botId, channel, db, limit)"
          ],
          "help": {
            "text": "List a bot's most recently active chats from the persistent message log: chatId, user, last message, and time, one entry per distinct chat, newest first",
            "variables": [
              {
                "name": "botId",
                "text": "Bot id, as configured under bots.<id>",
                "arg": true
              },
              {
                "name": "channel",
                "text": "Narrow to one channel plugin (default: every channel this bot has logged messages on)",
                "default": ""
              },
              {
                "name": "db",
                "text": "Repository database for bot state (message log)",
                "default": ".bot/state.db"
              },
              {
                "name": "limit",
                "text": "Maximum number of chats to return",
                "default": "20"
              }
            ]
          }
        },
        {
          "name": "messages",
          "execute": [
            "node ${packageDir}/lib/bot.mjs messages values(botId, chat, channel, db, limit)"
          ],
          "help": {
            "text": "List message history for one chat, both directions (inbound and outbound), oldest first, from the persistent message log",
            "variables": [
              {
                "name": "botId",
                "text": "Bot id, as configured under bots.<id>",
                "arg": true
              },
              {
                "name": "chat",
                "text": "Chat id to show history for",
                "default": ""
              },
              {
                "name": "channel",
                "text": "Narrow to one channel plugin (default: every channel this bot has logged messages on)",
                "default": ""
              },
              {
                "name": "db",
                "text": "Repository database for bot state (message log)",
                "default": ".bot/state.db"
              },
              {
                "name": "limit",
                "text": "Maximum number of messages to return",
                "default": "50"
              }
            ]
          }
        },
        {
          "name": "echo",
          "execute": [
            "profile:bot:echo"
          ],
          "help": {
            "text": "The 'echo' channel plugin — a reference implementation and in-repo test fixture (not a real platform)"
          }
        }
      ]
    },
    {
      "name": "bot:echo",
      "commands": [
        {
          "name": "verify",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-verify"
          ],
          "help": {
            "text": "echo plugin: verify an inbound request (HMAC-SHA256 over the raw body, or echo a GET handshake challenge)"
          }
        },
        {
          "name": "ingest-parse",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-ingest-parse"
          ],
          "help": {
            "text": "echo plugin: parse a raw webhook body into normalized core events"
          }
        },
        {
          "name": "typing",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-typing"
          ],
          "help": {
            "text": "echo plugin: signal that a reply is being worked on"
          }
        },
        {
          "name": "download",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-download"
          ],
          "help": {
            "text": "echo plugin: materialize an attached file onto local disk"
          }
        },
        {
          "name": "format",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-format"
          ],
          "help": {
            "text": "echo plugin: convert the brain's markdown answer into the channel's native format"
          }
        },
        {
          "name": "send",
          "private": true,
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/bot.mjs echo-send"
          ],
          "help": {
            "text": "echo plugin: deliver the formatted reply"
          }
        }
      ]
    }
  ]
}
